app.use("/api/trades",         crudRouter("trades",         ["buyer_email","buyer_name","seller_email","seller_name","item_name","item_description","delivery_deadline","dispatch_company","rider_name","rider_phone","tracking_code"], {
  adminOnlyFields: ["buyer_id","seller_id","amount","calculated_fee","fee_payer","status","reference","virtual_bank_name","virtual_account_number","virtual_account_expires_at","shipped_at","confirmed_at","auto_release_at","release_days","seller_message","accepted_at","rejected_at"],
}));
app.use("/api/webhook-events", crudRouter("webhook_events", ["event_type","payload","status","source","retries"]));

app.get("/api/health", (_, res) => res.json({ status: "ok", db: "postgresql" }));

